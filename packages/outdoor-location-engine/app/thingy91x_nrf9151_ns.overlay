/* Physical connections: TX=P0.18, RX=P0.19 (EXP connector). */
&pinctrl {
    uart1_rak_default: uart1_rak_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 18)>,
                    <NRF_PSEL(UART_RX, 0, 19)>;
        };
    };
    uart1_rak_sleep: uart1_rak_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 18)>,
                    <NRF_PSEL(UART_RX, 0, 19)>;
            low-power-enable;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_rak_default>;
    pinctrl-1 = <&uart1_rak_sleep>;
    pinctrl-names = "default", "sleep";
};

/ {
    gpiocustom {
        compatible = "gpio-keys";
        gpiocus10: gpiocus_10 {
            gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
            label = "Custom gpio 10";
        };
    };
    aliases {
        lora-uart = &uart1;
        gpiocus10 = &gpiocus10;
    };
};
