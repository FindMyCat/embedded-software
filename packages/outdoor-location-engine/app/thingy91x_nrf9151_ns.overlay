/* Repurpose uart1 (normally nRF5340 comms) for RAK3172 LoRa module.
 * New pinctrl nodes avoid merging with the original uart1_default/sleep
 * (which would leave the old P0.4/P0.5 groups in place).
 * Physical connections: TX=P0.18, RX=P0.19 (EXP connector). */
&pinctrl {
    uart1_rak_default: uart1_rak_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 18)>,
                    <NRF_PSEL(UART_RX, 0, 19)>;
        };
    };
    uart1_rak_sleep: uart1_rak_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 18)>,
                    <NRF_PSEL(UART_RX, 0, 19)>;
            low-power-enable;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_rak_default>;
    pinctrl-1 = <&uart1_rak_sleep>;
    pinctrl-names = "default", "sleep";
};

/ {
    aliases {
        lora-uart = &uart1;
    };
};
