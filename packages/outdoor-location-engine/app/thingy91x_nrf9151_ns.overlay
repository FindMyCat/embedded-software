/* Physical connections: TX=P0.24, RX=P0.23 (EXP connector). */
&pinctrl {
    uart0_rak_default: uart0_rak_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 24)>,
                    <NRF_PSEL(UART_RX, 0, 23)>;
        };
    };
    uart0_rak_sleep: uart0_rak_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 24)>,
                    <NRF_PSEL(UART_RX, 0, 23)>;
            low-power-enable;
        };
    };
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_rak_default>;
    pinctrl-1 = <&uart0_rak_sleep>;
    pinctrl-names = "default", "sleep";
};

#include <thingy91x_wifi.dtsi>

/ {
    gpiocustom {
        compatible = "gpio-keys";
        gpiocus10: gpiocus_10 {
            gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
            label = "Custom gpio 10";
        };
    };
    aliases {
        lora-uart = &uart0;
        gpiocus10 = &gpiocus10;
    };
    /* aliases { */
    /*     gpiocus10 = &gpiocus10; */
    /* }; */
};
