menu "Find My Cat main configuration"

config LTE_CONNECT_RETRY_DELAY_S
	int "Seconds to delay before attempting to retry LTE connection"
	default 20

config LTE_CONNECT_MAX_RETRIES
	int "Max retry attempts for LTE connection"
	default 4

config FINDMYCAT_CLOUD_HOSTNAME
	string "Hostname of the FindMyCat Cloud"

config MQTT_SN_GATEWAY_PORT
	int "Port of the MQTT-SN gateway"

config MQTT_SN_BUFFER_SIZE
	int "Size of the TX and RX buffers"
	default 255

config MQTT_SN_PUBLISH_TOPIC
	string "MQTT Topic to publish to"
	default "/location"

config MQTT_SN_REFRESH_PERIOD_SECONDS
	int "MQTT-SN refresh period in seconds"
	default 60

config LOCATION_SERVICES_INIT_MAX_RETRIES
	int "Max retry attempts for location services initialization"
	default 4

config LOCATION_SERVICES_INIT_RETRY_DELAY_S
	int "Seconds to delay before attempting to retry location services initialization"
	default 20

config DEVICE_ID
	string "Device ID"
	default "nrf9160"

config ACTIVE_MODE_LOCATION_REFRESH_PERIOD_SECONDS
	int "Location refresh period in seconds for Active Mode"
	default 1800	

config LOST_MODE_LOCATION_REFRESH_PERIOD_SECONDS
	int "Location refresh period in seconds for Lost Mode"
	default 30

config LORA_CAD_RX_TEST
	bool "CAD receive bench test"
	help
	  Run the duty-cycled CAD receive loop and log packets instead of
	  continuing to the rest of the application. Requires the CAD firmware
	  on the RAK3172.

config LORA_CAD_RX_TEST_SYMBOLS
	int "CAD symbol count index (0=1, 1=2, 2=4, 3=8, 4=16)"
	depends on LORA_CAD_RX_TEST
	default 1

config LORA_CAD_RX_TEST_DET_PEAK
	int "CAD detection peak threshold"
	depends on LORA_CAD_RX_TEST
	default 22

config LORA_CAD_RX_TEST_DET_MIN
	int "CAD detection minimum"
	depends on LORA_CAD_RX_TEST
	default 10

config LORA_CAD_RX_TEST_INTERVAL_MS
	int "Sniff interval in milliseconds"
	depends on LORA_CAD_RX_TEST
	default 450

config LORA_CAD_RX_TEST_LOW_POWER
	bool "Leave the RAK3172 in low power mode during the test"
	depends on LORA_CAD_RX_TEST
	help
	  Keeps AT+LPM=1 and stops polling AT+CADSTAT, so the module can sleep
	  between sniffs. Required for a meaningful current measurement, at the
	  cost of sluggish AT responses and no periodic counters.

config LORA_CAD_RX_TEST_WAKE_PIN
	int "RUI3 pin number the RAK3172 drives as the wake line"
	depends on LORA_CAD_RX_TEST
	default 9
	help
	  RUI3 numbering is port * 16 + pin, so PA9 is 9 and PB5 is 21. Reaches
	  the nRF9151 on the lora-wake alias. 4294967295 leaves the pin unused.

config LORA_CAD_RX_TEST_ABSENCE_S
	int "Seconds without a detection before the wake line asserts (0 = off)"
	depends on LORA_CAD_RX_TEST
	default 30

endmenu

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu

module = FINDMYCAT_OUTDOOR_LOCATION_ENGINE
module-str = FindMyCat outdoor location engine
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"