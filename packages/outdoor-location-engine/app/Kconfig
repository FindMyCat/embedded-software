menu "Find My Cat main configuration"

config LTE_CONNECT_RETRY_DELAY_S
	int "Seconds to delay before attempting to retry LTE connection"
	default 20

config LTE_CONNECT_MAX_RETRIES
	int "Max retry attempts for LTE connection"
	default 4

config FINDMYCAT_CLOUD_HOSTNAME
	string "Hostname of the FindMyCat Cloud"

config MQTT_SN_GATEWAY_ID
	int "Id of the MQTT-SN gateway"
	default 1
	help
	  Must match mqtt.sn.gateway_id in the broker's emqx_sn.conf.

config MQTT_SN_GATEWAY_PORT
	int "Port of the MQTT-SN gateway"

config MQTT_SN_BUFFER_SIZE
	int "Size of the TX and RX buffers"
	default 255

config MQTT_SN_PUBLISH_TOPIC
	string "MQTT Topic to publish to"
	default "/location"

config MQTT_SN_REFRESH_PERIOD_SECONDS
	int "MQTT-SN refresh period in seconds"
	default 60

config LOCATION_SERVICES_INIT_MAX_RETRIES
	int "Max retry attempts for location services initialization"
	default 4

config LOCATION_SERVICES_INIT_RETRY_DELAY_S
	int "Seconds to delay before attempting to retry location services initialization"
	default 20

config DEVICE_ID
	string "Device ID"
	default "nrf9160"

config ACTIVE_MODE_LOCATION_REFRESH_PERIOD_SECONDS
	int "Location refresh period in seconds for Active Mode"
	default 1800	

config LOST_MODE_LOCATION_REFRESH_PERIOD_SECONDS
	int "Location refresh period in seconds for Lost Mode"
	default 30

config SPOOF_PING_BASE_LATITUDE_MICRODEGREES
	int "Latitude a test ping reports, in millionths of a degree"
	default 37423021
	help
	  A test ping publishes a position near this point instead of waiting for
	  a GNSS fix, so the gateway, rule engine and Traccar can be exercised in
	  seconds. 37423021 is 37.423021.

config SPOOF_PING_BASE_LONGITUDE_MICRODEGREES
	int "Longitude a test ping reports, in millionths of a degree"
	default -122083739

config SPOOF_PING_JITTER_MICRODEGREES
	int "Random spread applied to a test ping position"
	default 1000
	help
	  Each test ping lands within this many millionths of a degree of the
	  base point, so repeated pings move on the map rather than stacking.
	  1000 is about 100 metres.

endmenu

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu

module = FINDMYCAT_OUTDOOR_LOCATION_ENGINE
module-str = FindMyCat outdoor location engine
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"