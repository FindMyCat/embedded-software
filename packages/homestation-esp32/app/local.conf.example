# Copy to local.conf and fill in. local.conf is gitignored.
CONFIG_WIFI_STATION_SSID="your-ssid"
CONFIG_WIFI_STATION_PSK="your-password"
CONFIG_WIFI_GEOLOCATION_API_KEY="your-google-api-key"

CONFIG_DEVICE_ID="your-findmycat-device-id"

CONFIG_MQTT_PUBLISHER_BROKER_HOST="your-broker-hostname"
CONFIG_MQTT_PUBLISHER_LOCATION_TOPIC="/your-location-topic"

CONFIG_MQTT_PUBLISHER_HOME_LATITUDE="0.0"
CONFIG_MQTT_PUBLISHER_HOME_LONGITUDE="0.0"
