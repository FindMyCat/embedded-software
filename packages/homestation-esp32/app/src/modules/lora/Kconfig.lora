menu "LoRa"

config LORA_THREAD_STACK_SIZE
	int "Thread stack size"
	default 8192

config LORA_MESSAGE_QUEUE_SIZE
	int "Message queue size"
	default 4

config LORA_ABSENCE_S
	int "Seconds without a frame from the collar before it counts as gone"
	default 900


config LORA_LOCATE_WINDOW_S
	int "Seconds to keep pinging after the locate button is pressed"
	default 180

config LORA_BEACON_INTERVAL_S
	int "Seconds between LORA beacons"
	default 30

config LORA_PING_PREAMBLE
	int "Ping preamble length in symbols"
	default 512

config LORA_REPLY_TO_HEARTBEAT
	bool "Transmit only in reply to the collar's heartbeat"
	default y
	help
	  Each heartbeat marks the start of a collar CAD burst, so a beacon or
	  a pending ping sent straight back is heard, and the periodic beacon
	  is not needed. Locate latency becomes the collar's heartbeat period.
	  Off restores beaconing every CONFIG_LORA_BEACON_INTERVAL_S.

config LORA_PAUSE_FOR_BLE
	bool "Stop LoRa receive while the tag is in BLE range"
	default y
	help
	  Off keeps the receiver on regardless, for testing the LoRa link with
	  the collar nearby.

config LORA_TX_POWER_DBM
	int "P2P transmit power in dBm (5-22)"
	default 5

module = LORA
module-str = LoRa
source "subsys/logging/Kconfig.template.log_config"

endmenu # LoRa
